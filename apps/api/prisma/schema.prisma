generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id               String         @id @default(uuid()) @db.Uuid
  name             String
  slug             String         @unique
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  address          String
  city             String
  state            String         @default("")
  contactEmail     String         @map("contact_email")
  contactPhone     String         @map("contact_phone")
  country          String
  timezone         String         @default("UTC")
  logoUrl          String?        @map("logo_url")
  stripeCustomerId String?        @unique
  attendance       Attendance[]
  members              Member[]
  refreshToken         RefreshToken[]
  roles                Role[]
  tenantUsers          TenantUser[]
  trainers             Trainer[]
  subscriptions        Subscription[]
  membershipPackages   MembershipPackage[]
  staffAttendances     StaffAttendance[]
  memberGoal       MemberGoal[]
  workoutPlan      WorkoutPlan[]
  dietLog          DietLog[]
  workoutLog       WorkoutLog[]
  weightLog        WeightLog[]

  @@map("tenants")
}

model TenantUser {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tenantId  String   @db.Uuid
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
  roleId    String?  @db.Uuid
  roleRef   Role?    @relation(fields: [roleId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("tenant_users")
}

model User {
  id               String         @id @default(uuid()) @db.Uuid
  email            String         @unique
  passwordHash     String         @map("password_hash")
  firstName        String         @map("first_name")
  lastName         String         @map("last_name")
  resetToken       String?        @unique
  resetTokenExpiry DateTime?
  role             String         @default("STAFF")
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  refreshToken     RefreshToken[]
  tenants          TenantUser[]
  trainerProfile   Trainer?
  staffAttendances StaffAttendance[]

  @@map("users")
}

model Member {
  id                   String              @id @default(uuid()) @db.Uuid
  email                String
  firstName            String              @map("first_name")
  lastName             String              @map("last_name")
  phone                String?
  dateOfBirth          DateTime?           @map("date_of_birth")
  status               MemberStatus        @default(ACTIVE)
  assignedTrainerId    String?             @map("assigned_trainer_id") @db.Uuid
  packageId            String?             @map("package_id") @db.Uuid
  membershipStartDate  DateTime?           @map("membership_start_date")
  membershipExpiresAt  DateTime?           @map("membership_expires_at")
  paymentStatus        MemberPaymentStatus @default(PENDING) @map("payment_status")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")
  tenantId             String              @map("tenant_id") @db.Uuid
  attendances          Attendance[]
  assignedTrainer      Trainer?            @relation(fields: [assignedTrainerId], references: [id])
  membershipPackage    MembershipPackage?  @relation(fields: [packageId], references: [id])
  tenant               Tenant              @relation(fields: [tenantId], references: [id])
  memberGoal           MemberGoal[]
  workoutPlan          WorkoutPlan[]
  dietLog              DietLog[]
  workoutLog           WorkoutLog[]
  weightLog            WeightLog[]

  @@unique([email, tenantId])
  @@index([tenantId, packageId])
  @@index([tenantId, membershipExpiresAt])
  @@map("members")
}

model Trainer {
  id             String        @id @default(uuid()) @db.Uuid
  specialization String?
  bio            String?
  userId         String        @unique @map("user_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  tenantId       String        @map("tenant_id") @db.Uuid
  members          Member[]
  workoutPlan      WorkoutPlan[]
  staffAttendances StaffAttendance[]
  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@map("trainers")
}

model SuperAdmin {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String                   @unique
  passwordHash String                   @map("password_hash")
  firstName    String                   @map("first_name")
  lastName     String                   @map("last_name")
  role         String                   @default("SUPER_ADMIN")
  isActive     Boolean                  @default(true) @map("is_active")
  lastLoginAt  DateTime?                @map("last_login_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")
  refreshToken SuperAdminRefreshToken[]

  @@map("super_admins")
}

model SuperAdminRefreshToken {
  id           String     @id @default(uuid()) @db.Uuid
  superAdminId String     @map("super_admin_id") @db.Uuid
  token        String     @unique
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)

  @@map("super_admin_refresh_tokens")
}

model Attendance {
  id         String    @id @default(uuid()) @db.Uuid
  checkIn    DateTime  @default(now()) @map("check_in")
  checkOut   DateTime? @map("check_out")
  deviceInfo String?   @map("device_info")
  memberId   String    @map("member_id") @db.Uuid
  tenantId   String    @db.Uuid
  date       DateTime  @db.Date
  member     Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tenant     Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([memberId, date])
  @@index([memberId, checkIn])
  @@map("attendance")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  expiryAt  DateTime @map("expiry_at")
  createdAt DateTime @default(now()) @map("created_at")
  tenantId  String?  @db.Uuid
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model InviteToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String
  tenantId  String   @db.Uuid
  role      String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")

  @@map("invite_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  tenantId    String           @db.Uuid
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       TenantUser[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
  BANNED
  DELETED
}

enum MemberPaymentStatus {
  PAID
  PENDING
}

model MembershipPackage {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  description  String?
  durationDays Int      @map("duration_days")
  price        Int
  currency     String   @default("INR")
  isActive     Boolean  @default(true) @map("is_active")
  features     String[] @default([])
  featureLimits Json    @default("{}") @map("feature_limits")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members      Member[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("membership_packages")
}

model StaffAttendance {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  trainerId String?   @map("trainer_id") @db.Uuid
  date      DateTime  @db.Date
  checkIn   DateTime  @default(now()) @map("check_in")
  checkOut  DateTime? @map("check_out")
  present   Boolean   @default(true)
  notes     String?
  createdAt DateTime  @default(now()) @map("created_at")
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer   Trainer?  @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId, date])
  @@index([tenantId, date])
  @@index([trainerId, date])
  @@map("staff_attendance")
}

model Plan {
  id            String          @id @default(uuid()) @db.Uuid
  name          PlanName
  price         Int
  currency      String
  interval      BillingInterval
  stripePriceId String?         @unique

  features Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@unique([name, interval])
}

enum PlanName {
  FREE
  BASIC
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

model Subscription {
  id                   String  @id @default(uuid())
  tenantId             String  @unique @db.Uuid
  planId               String  @db.Uuid
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique

  status SubscriptionStatus

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])
}

model AttendanceDailyStats {
  id            String   @id @default(uuid())
  tenantId      String
  date          DateTime
  totalCheckIns Int
  createdAt     DateTime @default(now())

  @@unique([tenantId, date])
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum GoalType {
  GAIN
  LOSS
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model MemberGoal {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @db.Uuid
  tenantId String @db.Uuid

  goalType      GoalType
  currentWeight Float
  targetWeight  Float
  durationWeeks Int
  height        Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([memberId])
  @@index([tenantId, memberId])
  @@map("member_goals")
}

model WorkoutPlan {
  id        String @id @default(uuid()) @db.Uuid
  memberId  String @db.Uuid
  trainerId String @db.Uuid
  tenantId  String @db.Uuid

  name     String
  goalType GoalType

  version  Int
  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  member  Member  @relation(fields: [memberId], references: [id])
  trainer Trainer @relation(fields: [trainerId], references: [id])
  tenant  Tenant  @relation(fields: [tenantId], references: [id])

  days WorkoutDay[]

  @@index([memberId])
  @@index([tenantId, memberId])
  @@map("workout_plans")
}

model WorkoutDay {
  id        String @id @default(uuid()) @db.Uuid
  planId    String @db.Uuid
  dayNumber Int

  createdAt DateTime @default(now())

  plan      WorkoutPlan       @relation(fields: [planId], references: [id])
  exercises WorkoutExercise[]

  @@unique([planId, dayNumber])
  @@map("workout_days")
}

model WorkoutExercise {
  id    String @id @default(uuid()) @db.Uuid
  dayId String @db.Uuid

  name String
  sets Int
  reps Int

  createdAt DateTime @default(now())

  day WorkoutDay @relation(fields: [dayId], references: [id])

  @@map("workout_exercises")
}

model FoodMaster {
  id   String @id @default(uuid()) @db.Uuid
  name String
  unit String

  caloriesPerUnit Float
  protein         Float?
  carbs           Float?
  fat             Float?

  source String // API / USER

  createdAt DateTime @default(now())

  dietItems DietLogItem[]

  @@unique([name, unit])
  @@map("food_master")
}

model DietLog {
  id       String   @id @default(uuid()) @db.Uuid
  memberId String   @db.Uuid
  tenantId String   @db.Uuid
  date     DateTime

  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  items DietLogItem[]

  @@unique([memberId, date])
  @@index([memberId, date])
  @@index([tenantId, memberId])
  @@map("diet_logs")
}

model DietLogItem {
  id        String @id @default(uuid()) @db.Uuid
  dietLogId String @db.Uuid
  foodId    String @db.Uuid

  mealType MealType

  quantity      Float
  totalCalories Float

  createdAt DateTime @default(now())

  dietLog DietLog    @relation(fields: [dietLogId], references: [id])
  food    FoodMaster @relation(fields: [foodId], references: [id])

  @@index([dietLogId])
  @@map("diet_log_items")
}

model WorkoutLog {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @db.Uuid
  tenantId String @db.Uuid

  exercise String
  weight   Float
  sets     Int
  reps     Int

  date      DateTime
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([memberId, date])
  @@index([tenantId, memberId])
  @@map("workout_logs")
}

model WeightLog {
  id       String @id @default(uuid()) @db.Uuid
  memberId String @db.Uuid
  tenantId String @db.Uuid

  weight Float
  date   DateTime

  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([memberId, date])
  @@index([tenantId, memberId])
  @@map("weight_logs")
}
